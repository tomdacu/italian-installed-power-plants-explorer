{
  "name": "italian-renewable-capacity-explorer",
  "version": "1.0.0",
  "type": "module",
  "description": "Explore Italy's renewable installed generation capacity (solar, wind, hydro, bioenergy, geothermal) by region and province \u2014 data from the Terna Developer API, cached locally.",
  "license": "MIT",
  "bin": {
    "ice": "server/cli.ts"
  },
  "files": [
    "server/",
    "shared/",
    "static/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "bun run scripts/clean.ts && vite build",
    "serve": "bun run server/cli.ts",
    "serve:browser": "bun run server/cli.ts --browser",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview --port 1420",
    "prepack": "bun run build && bun run scripts/copy-static.ts",
    "compile": "bun run prepack && bun build server/cli.ts --compile --outfile dist-exe/ice.exe --windows-hide-console --windows-icon=assets/icon.ico --windows-title=\"Italian Renewable Capacity Explorer\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/sora": "^5.2.8",
    "@tanstack/react-query": "^5.51.0",
    "clsx": "^2.1.1",
    "hono": "^4.6.14",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomdacu/italian-renewable-capacity-explorer.git"
  },
  "homepage": "https://github.com/tomdacu/italian-renewable-capacity-explorer#readme",
  "bugs": {
    "url": "https://github.com/tomdacu/italian-renewable-capacity-explorer/issues"
  },
  "keywords": [
    "terna",
    "italy",
    "renewable",
    "capacity",
    "energy",
    "solar",
    "wind",
    "hydro",
    "open-data",
    "bun"
  ],
  "author": "Tommaso D'Acunzio"
}
