# Opzionale: punta la SPA a un backend diverso da quello che la serve.
# In sviluppo il dev server Vite inoltra già /health, /records, /analytics,
# /metadata, /settings, /sync e /export al server locale (vedi vite.config.ts),
# quindi normalmente NON serve impostare nulla.
# VITE_API_BASE_URL=http://127.0.0.1:8799
# VITE_API_PROXY=http://127.0.0.1:8799
