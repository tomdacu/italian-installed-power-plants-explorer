# --- Node / frontend ---
node_modules
dist
dist-ssr
.vite
*.local

# --- Build outputs ---
# static/ is the built interface copied from dist/ (scripts/copy-static.ts);
# dist-exe/ holds the compiled single-file executable. Both are reproducible.
# dist-new/ and static-new/ are the staging directories of scripts/build.ts,
# dist-old/ and static-old/ the rollback backups: every directory is committed
# into place with a rename only when complete, and the leftovers are removed
# on failure (a crashed run may leave them behind, hence the ignores).
static/
dist-exe/
dist-new/
static-new/
dist-old/
static-old/
*.tsbuildinfo


# --- Release artifacts ---
# Installers are published as GitHub Releases, not committed.
release/
*.exe
*.msi

# --- Documents / source material that must not be published ---
*.pptx
*.docx
*.xlsx

# --- Editors / OS ---
.DS_Store
Thumbs.db
desktop.ini
.idea
.vscode/*
!.vscode/extensions.json

# --- Local configuration and secrets ---
.env
.env.*
!.env.example
# Terra Developer credentials pasted locally (never published)
api.txt
*.log

# --- Internal working documents (not part of the public project) ---
notes/
